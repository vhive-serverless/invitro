{
  "Seed": 42,

  "Platform": "nexus",
  "InvokeProtocol" : "grpc",
  "YAMLSelector": "nexus",
  "EndpointPort": 80,

  "BusyLoopOnSandboxStartup": false,

  "TracePath": "$TRACE_PATH",
  "Granularity": "minute",
  "OutputPathPrefix": "$OUTPUT_PREFIX",
  "IATDistribution": "exponential",
  "CPULimit": "1vCPU",
  "ExperimentDuration": $EXP_DUR,
  "WarmupDuration": $WARMUP,

  "IsPartiallyPanic": false,
  "EnableZipkinTracing": false,
  "EnableMetricsScrapping": true,
  "MetricScrapingPeriodSeconds": 1,
  "AutoscalingMetric": "concurrency",

  "GRPCConnectionTimeoutSeconds": 5,
  "GRPCFunctionTimeoutSeconds": 20,
  "DAGMode": false,
  "EnableDAGDataset": true,
  "Width": 2,
  "Depth": 2,
  
  "EnablePrefetch": $PREFETCH,
  "EnablePerfCollection": $ENABLE_PERF,
  "FixedReplicaCount": $FIXED_REPLICAS
}
